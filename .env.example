# Copia in .env.local e compila. Non committare mai .env.local e non incollare questi valori in chat.

# Neon Postgres (stringa di connessione dal pannello Neon)
DATABASE_URL=
# Ruolo applicativo NON proprietario (le policy RLS valgono solo per lui). Vedi docs/database.md.
DATABASE_URL_APP=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (facoltativo finché non crei le credenziali in Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (in sviluppo, se vuoto, il magic link si stampa in console)
RESEND_API_KEY=
EMAIL_FROM=
# Destinatario delle richieste del modulo di contatto (bug, domande, dati). Se vuoto, si usa EMAIL_FROM.
CONTACT_EMAIL=

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=

# Cloudflare R2 (in sviluppo, se vuoto, l'audio resta su disco locale)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Mostra anche le lezioni in bozza in produzione (solo per anteprime). Vuoto = solo `published`.
SHOW_DRAFTS=

# Segreto per /api/cron/reminders (chiamato ogni ora da uno scheduler esterno)
CRON_SECRET=
# Strumenti interni (anteprima email/interfacce, revisione video) in produzione: 1 per abilitarli
ENABLE_INTERNAL_TOOLS=

# AI Dojo (assistente di studio). Chiave gratuita da Google AI Studio: vedi docs/ai-dojo.md. Solo lato server.
GEMINI_API_KEY=
# Facoltativo: modello Gemini (se vuoto usa quello indicato in docs/ai-dojo.md)
GEMINI_MODEL=
# Provider alternativo al Dojo (API compatibile OpenAI). Vedi docs/ai-dojo.md.
GROQ_API_KEY=
# Facoltativo: modello Groq (se vuito usa openai/gpt-oss-20b)
GROQ_MODEL=
